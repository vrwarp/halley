# ==============================================================================
# Halley Configuration
# Copy to .env.local for local development or .env for Docker Compose.
# ==============================================================================

# Target Repository (1 deployment = 1 GitHub repository)
HALLEY_REPO=vrwarp/thecrossing.website
HALLEY_BASE_BRANCH=main
# Optional GitHub Actions workflow filename or name used to confirm live site deployment (auto-detects deploy/pages workflow if unset)
# HALLEY_DEPLOY_WORKFLOW=deploy.yml
# Optional override for Live vs Draft publish screenshots (defaults to https://<owner>.github.io/<repo> from HALLEY_REPO; set to "none" to disable)
# HALLEY_LIVE_SITE_URL=

# GitHub Authentication (GitHub App preferred; fine-grained PAT also supported)
# Required permissions: Contents (Read & Write), Pull Requests (Read & Write),
# Checks / Actions (Read, for CI & Pages deployment polling)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_TOKEN=

HALLEY_GIT_BOT_NAME=Halley Bot
HALLEY_GIT_BOT_EMAIL=halley-bot@users.noreply.github.com

# Google OAuth & Editor Access Control
# Redirect URI to register in Google Cloud Console:
#   ${HALLEY_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HALLEY_PUBLIC_URL=http://localhost:3000

# Comma-separated allowlists (Admins are automatically allowlisted)
HALLEY_ADMIN_EMAILS=
HALLEY_ALLOWED_EMAILS=
HALLEY_ALLOWED_DOMAINS=

# Cookie signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# LLM & Daily Spend Control (Server-Managed via Control Plane Proxy)
# Use exact model IDs (as below). The meta aliases "haiku-latest", "sonnet-latest" and
# "opus-latest" are also accepted, but they are re-pointed to newer models over time, which changes
# agent behaviour, cost and output style without any code or config change on your side. Pin an
# exact ID in production and bump it deliberately (the code defaults are exact IDs: claude-haiku-5-5, and claude-opus-5-5 for escalation).
ANTHROPIC_API_KEY=
HALLEY_MODEL_PROVIDER=anthropic
HALLEY_MODEL_ID=claude-haiku-5-5
HALLEY_THINKING_LEVEL=high
HALLEY_CONFLICT_MODEL=claude-haiku-5-5
HALLEY_ESCALATION_MODEL=claude-opus-5-5
HALLEY_ESCALATION_THINKING=medium
HALLEY_ESCALATION_MAX_USD=2.00
HALLEY_DAILY_COST_CAP_USD=10.00

# Control Plane Server
PORT=3000
# Optional override (defaults to /data in Docker image, ./data in local dev)
# DATA_DIR=./data

# Workspace Host Orchestration (2-container stack: control-plane + workspaces)
# Leave WORKSPACE_HOST_URL unset in local dev to auto-spawn the supervisor locally.
# In Docker Compose, control-plane connects to http://workspaces:4000.
# WORKSPACE_HOST_URL=http://workspaces:4000
# Optional shared Bearer secret between control-plane and workspaces (trusts private halley-net if unset)
# WORKSPACE_HOST_SECRET=
CONTROL_PLANE_INTERNAL_URL=http://control-plane:3000
# Shared image tag for both control-plane and workspaces in docker-compose.prod.yml.
# Recommended: pin the immutable 7-char git-sha tag that CI pushes for every main commit
# (e.g. HALLEY_TAG=1a2b3c4), so both containers always run the same, tested build and an
# unattended `docker compose pull` never upgrades you. `latest` (the default when unset) is
# moved by CI after each successful main build.
# HALLEY_TAG=1a2b3c4
# Pooled RAM limit for the workspaces container in Docker Compose
# WORKSPACES_MEMORY_LIMIT=6g
# Soft LRU cap on concurrent awake workspaces (oldest idle session sleeps automatically)
MAX_ACTIVE_WORKSPACES=5
WORKSPACE_IDLE_TIMEOUT_MS=1200000
HALLEY_BROWSER_IDLE_TIMEOUT_MS=3600000
ARCHIVE_RETENTION_DAYS=420
NODE_MODULES_PRUNE_DAYS=7
# Keep N pre-warmed standby workspace subprocesses ready so new edits open instantly (default: 1 in Docker, 0 local)
HALLEY_WARM_POOL_SIZE=1

# Optional local testing only (NEVER enable in production)
HALLEY_DEV_LOGIN=false
HALLEY_DEV_LOCAL_REPO=
